# Tailscale: reusable auth key from login.tailscale.com -> Settings -> Keys
TS_AUTHKEY=changeMe
# Beszel: both values come from the hub UI (port 8090) -> Add System / Settings -> Tokens
BESZEL_KEY=changeMe
BESZEL_TOKEN=changeMe
# Jellyfin: host path to the music library, mounted read-only at /media/music.
# Must exist and be mounted before the container is created, or the library is empty.
JELLYFIN_MUSIC_DIR=/mnt/ssd/music
JELLYFIN_MOVIES_DIR=/mnt/ssd/movies
JELLYFIN_TVSHOWS_DIR=/mnt/ssd/tvshows

# Penpot config lives in docker/penpot/.env
# Navidrome config lives in docker/navidrome/.env
# Silo, VaultS3, RustFS, Garage and SeaweedFS credentials live in docker/<service>/.env
HOMARR_SECRET_ENCRYPTION_KEY=2c9e46942827cc27f67711d57e11dab644c605b394141032820e95658ba2d6ce

# Mosquitto (MQTT broker in homeassistant/docker-compose.yml). The broker rebuilds its
# password file from these on every start, and Zigbee2MQTT logs in with the same pair.
# Home Assistant does not read this file: enter them once in its MQTT integration.
MQTT_USER=homeassistant
MQTT_PASSWORD=cf1e24778b689ecc7f9ab72551742e7c
# SMLIGHT SLZB-06M Zigbee coordinator: its LAN IP (shown in its web UI or the router).
# zigbee2mqtt connects to tcp://<this>:6638. Reserve the IP on the router so it never moves.
SLZB_HOST=

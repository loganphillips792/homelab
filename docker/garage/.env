# Garage default key and bucket, created on startup by `--default-bucket`.
# Garage enforces its own key format — access key is "GK" + 24 hex chars, secret is
# 64 hex chars — so the admin/changeMe123 pair used elsewhere won't work here.
GARAGE_DEFAULT_ACCESS_KEY=GKe49202858fdf5952e2643e55
GARAGE_DEFAULT_SECRET_KEY=b75307994d41c9ab02ee9d8dec50dfd625456271af37e6dd2090322d79aa5668
GARAGE_DEFAULT_BUCKET=default

# garage-webui login (admin / changeMe123) as user:bcrypt-hash. Regenerate with
#   htpasswd -nbBC 10 admin <password>
# Single quotes stop compose from interpolating the $ in the hash.
GARAGE_WEBUI_AUTH='admin:$2y$10$fv1XCDFT11zmIoNdLcyLa.gvPwuUgzPH8w6fPzbvw0hkRgWTmp3za'

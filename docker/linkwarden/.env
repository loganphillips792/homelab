# Linkwarden secrets and config.
#
# Committed in plaintext to match the other per-service env files here
# (karakeep/.env, planka/.env, penpot/.env, navidrome/.env).
#
# NEXTAUTH_SECRET, POSTGRES_PASSWORD and MEILI_MASTER_KEY must all be three
# DIFFERENT secrets -- upstream is explicit about this. Regenerate any of them with:
#   openssl rand -hex 32

# Must be the .homelab hostname, not localhost: NextAuth builds its callback URLs
# from this, so pointing it at localhost breaks login through Caddy.
NEXTAUTH_URL=http://linkwarden.homelab/api/v1/auth
NEXTAUTH_SECRET=d61038166f13f594a7ffb48120cfa403fbb95bb9834e0ab8fd176ff274a2fdf3

# Sets the password on the linkwarden-postgres container's default 'postgres' user.
POSTGRES_PASSWORD=25a0eb8d89e50c4ed6333b4e3aff6c3d103513d2c16154a499bf1eaa48f1c53d

# Written out literally rather than as postgresql://postgres:${POSTGRES_PASSWORD}@...
# Compose interpolation and container env injection are different mechanisms: a ${VAR}
# inside the compose file resolves from the interpolation environment, NOT from a
# service's env_file, so the ${...} form would silently expand to an empty password.
# Keep this password in sync with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:25a0eb8d89e50c4ed6333b4e3aff6c3d103513d2c16154a499bf1eaa48f1c53d@linkwarden-postgres:5432/postgres

MEILI_MASTER_KEY=9cb3ffef0831d3aaca74351b4fe2417fb9ceac66ace826bd9b49305911fe0481

# AI tagging via the local ollama service. Uncomment and pick a pulled model to enable:
# NEXT_PUBLIC_OLLAMA_ENDPOINT_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.1

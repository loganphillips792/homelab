# Host path to the music library Navidrome serves (mounted read-only at /music).
# Falls back to ~/docker-volumes/navidrome/music if unset.
#
# This is a Mac path -- the Elements external drive. It does NOT exist on the
# Linux VM, and docker would silently create an empty dir there rather than fail,
# leaving navidrome scanning nothing. Point this somewhere real before running it
# on the VM.
NAVIDROME_MUSIC_DIR=/Volumes/Elements/Music
